# Django
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://forest_user:forest_pass@localhost:5433/forest_monitor?client_encoding=utf8

# Redis（推荐 Docker Redis >=5，映射本机 6379）
# channels-redis 4.x 需要 Redis >= 5（BZPOPMIN）；勿使用 Windows Redis 3.2
REDIS_URL=redis://localhost:6379/0
CHANNEL_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# InfluxDB 2.x (Docker init env: DOCKER_INFLUXDB_INIT_* in docker-compose.yml)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=forest-influxdb-super-token-2026
INFLUXDB_ORG=forest
INFLUXDB_BUCKET=forest_monitor

# EMQX MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=public
# 未知 device_id 自动登记到设备表（本地模拟器友好）
MQTT_AUTO_REGISTER_DEVICES=True

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=forest-monitor-ingest
KAFKA_AUTO_OFFSET_RESET=latest
# True: MQTT → Kafka → consume_kafka → Celery；False: MQTT 直投 Celery
USE_KAFKA_PIPELINE=True
# 新建 topic 分区数（已有 topic 需手动 kafka-topics --alter）
KAFKA_NUM_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_PRODUCER_ACKS=1
KAFKA_PRODUCER_LINGER_MS=50
KAFKA_PRODUCER_BATCH_SIZE=32768
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_MAX_POLL_RECORDS=100
# 单设备遥测入口最小间隔（秒），MQTT 桥接削峰；0=关闭
TELEMETRY_INGEST_MIN_INTERVAL=1.0
# 同设备同规则告警冷却（秒）
ALERT_RULE_DEDUP_SECONDS=300
# Celery worker 需 -Q telemetry,alerts,default
CELERY_WORKER_PREFETCH_MULTIPLIER=4

# File Storage (OSS/MinIO)
# 与 docker MinIO 的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 保持一致
AWS_ACCESS_KEY_ID=Admin
AWS_SECRET_ACCESS_KEY=Admin123
AWS_STORAGE_BUCKET_NAME=forest-monitor
AWS_S3_ENDPOINT_URL=http://localhost:9000
LOG_ARCHIVE_MINIO_PREFIX=log

# Prometheus
# 容器映射一般为 9090:9090；MinIO 为 9000(API)/9001(Console)
PROMETHEUS_URL=http://127.0.0.1:9090
DJANGO_METRICS_URL=http://127.0.0.1:8000/metrics
MINIO_CONSOLE_URL=http://127.0.0.1:9001
PROMETHEUS_METRICS_EXPORT_PORT=9090

# SSO 配置（基于 integration_hub SDK）
# 单中台默认配置（SSO_PARTNERS 为空时用这套）
SSO_PLATFORM_URL=http://127.0.0.1:8000
SSO_AUDIENCE=app_mu6b9ioz
SSO_APP_ID=app_1a0b23df2626GrEjJAf
# 多中台配置见 settings.py 的 SSO_PARTNERS 字典（按 iss 路由，支持多 platform_url + audience list）
