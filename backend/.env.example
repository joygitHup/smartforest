# Django
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forest_monitor?client_encoding=utf8

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# TDengine
TDENGINE_HOST=localhost
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=Taostaos@123
TDENGINE_DB=forest_monitor

# EMQX MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=public

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# File Storage (OSS/MinIO)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=forest-monitor
AWS_S3_ENDPOINT_URL=http://localhost:9000

# Prometheus
PROMETHEUS_METRICS_EXPORT_PORT=9090
